{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "one-api-workers",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-28",
  "workers_dev": true,
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "USAGE_ANALYTICS_DATASET": "usage_events_by_token"
    // 可选：管理端 API 允许的跨域来源（逗号分隔），未设置时仅允许同源访问
    // "ADMIN_CORS_ORIGINS": "https://admin.example.com"
  },
  "secrets": {
    "required": [
      "ADMIN_TOKEN",
      "CF_API_TOKEN",
      "CF_ACCOUNT_ID"
    ]
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/v1", "/v1/*", "/v1beta", "/v1beta/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "one-api-workers",
      "database_id": "c3f1dd47-482e-4609-b22d-3e58d33024b6"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "USAGE_ANALYTICS",
      "dataset": "usage_events_by_token"
    }
  ]
}
